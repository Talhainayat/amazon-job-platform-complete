# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file with real secrets.

# --- App ---
APP_NAME=Job Platform API
ENV=development
DEBUG=true

# --- Database ---
# Local dev default (SQLite, zero setup):
DATABASE_URL=sqlite:///./job_platform.db
# Postgres example (Milestone 3+):
# DATABASE_URL=postgresql://job_platform_user:CHANGE_ME@localhost:5432/job_platform

# --- Auth ---
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI (optional) ---
AI_API_KEY=
AI_PROVIDER=none

# --- Email (optional) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# --- Manager alerts (optional Twilio; webhook is used as fallback) ---
ADMIN_ALERT_PHONE_NUMBER=+923332158308
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=
ALERT_WEBHOOK_URL=
HIGH_MATCH_THRESHOLD=80

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Matching engine weights (must sum to 100) ---
MATCH_WEIGHT_LOCATION=35
MATCH_WEIGHT_SKILLS=20
MATCH_WEIGHT_JOB_TYPE=15
MATCH_WEIGHT_SHIFT=15
MATCH_WEIGHT_EXPERIENCE=8
MATCH_WEIGHT_PAY=7

# Seed demo admin/candidate + sample jobs on startup (development only)
SEED_DEMO_DATA=true
